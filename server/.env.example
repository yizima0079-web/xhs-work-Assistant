# 复制为 server/.env 后填写；不要把 server/.env 提交到仓库。
#
# 标了 [公网必改] 的默认值是**公开常量**，本地开发无所谓，
# 对外暴露（局域网 / 公网）不换等于门禁形同虚设。

# ---------------- 存储 ----------------
DATAPP_DB_BACKEND=sqlite
# 留空 / 不配 → 回落到 config.py 默认值 PROJECT_ROOT/storage/{datapp.db,raw,media}
# （PROJECT_ROOT = 项目根）。默认值既是绝对路径（不依赖 cwd），又跟着项目走，
# **迁移到别的机器不用改任何东西** —— 这才是推荐的用法。
# 只有确实要把数据放到项目外时才配下面三项：一旦配了就是绝对路径，换机器/换盘符即失效。
# DATAPP_DB_PATH=F:/datapp/storage/datapp.db
# DATAPP_RAW_DIR=F:/datapp/storage/raw
# DATAPP_MEDIA_DIR=F:/datapp/storage/media

# MongoDB Atlas（可选，确认连通后再把 DB_BACKEND 切成 mongodb）
# 连接串由 Atlas Connect -> Drivers 生成，不要把密码提交到代码或日志。
# DATAPP_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
# DATAPP_MONGODB_DATABASE=datapp
# DATAPP_MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# ---------------- OpenCLI 采集（仅本地） ----------------
# vendor/OpenCLI-1.8.8 不入库（见根 .gitignore），需自行构建后指向产物；
# 配一个不存在的路径也不会崩：适配器构造时不碰文件，只会让 /api/v1/health 的
# adapter 字段报不健康 —— 那是**诚实状态**（确实没装采集工具），不是故障。
DATAPP_OPENCLI_MAIN=F:/datapp/vendor/OpenCLI-1.8.8/dist/src/main.js
DATAPP_OPENCLI_NODE=node
OPENCLI_PROFILE=
OPENCLI_BROWSER_COMMAND_TIMEOUT=60
# Bridge 连接预算：扩展/daemon 不在线时让 OpenCLI 快速认输，不拖满命令超时
DATAPP_OPENCLI_CONNECT_TIMEOUT=45
# 硬超时 = 命令超时 + grace，越过即 kill 子进程（防 node 挂着占 Browser Bridge 会话）
DATAPP_OPENCLI_TIMEOUT_GRACE=30
# 写进 Run.tool_version，用于按工具版本复现采集差异
DATAPP_OPENCLI_VERSION=1.8.8

# ---------------- 限速 / 熔断 ----------------
# 0.1 = 10s/条，落在 AGENTS.md 的 5–30s 区间；改小前先想清楚风控后果
DATAPP_RATE_PER_SECOND=0.1
DATAPP_RATE_CAPACITY=1
# 间隔随机放大 [1, 1+jitter]，只增不减（有上限的抖动，不用于规避检测）
DATAPP_RATE_JITTER=0.4
DATAPP_CIRCUIT_BREAKER_THRESHOLD=3
DATAPP_GLOBAL_CONCURRENCY=1
DATAPP_MAX_ITEMS_DEFAULT=20

# ---------------- 管理员门禁 ----------------
# 算法必须与 server/app/auth.py 一致：PBKDF2-HMAC-SHA256，salt=b"datapp-admin"，310000 轮，取 hex。
# 生成（密码不回显，也不进 shell 历史）：
#   python -c "import hashlib,getpass;print(hashlib.pbkdf2_hmac('sha256',getpass.getpass().encode(),b'datapp-admin',310000).hex())"
# 留空会落回 server/app/config.py 里的**默认常量** —— 那是随仓库一起公开的值，
# 等于任何人都能登进看板。务必用上面算出的哈希覆盖它。
DATAPP_ADMIN_USERNAME=admin
DATAPP_ADMIN_PASSWORD_HASH=CHANGE_ME_PBKDF2_HEX_64
# 同样有公开默认值（config.py::auth_secret）。不换 → 会话 Cookie 可被伪造。
DATAPP_AUTH_SECRET=CHANGE_ME
DATAPP_AUTH_SESSION_HOURS=12

# ---------------- 移动端（app）设备令牌 ----------------
# app 用 X-Datapp-App-Token 头访问，免账号密码启动，可读可写，但**不含采集模块**
# （/collection-runs、/browser/* 一律 401 —— app 端本就不继承采集）。
# 配套：把同一个值填进根项目 local.properties 的 datapp.appToken（不入版本控制），
# 构建时经 buildConfigField 注入 BuildConfig.DATAPP_APP_TOKEN。
# 未设置 → 该通道关闭，app 回落登录页（仍可输管理员账号密码）。
DATAPP_APP_TOKEN=

# ---------------- 模型层（可选） ----------------
# key 只写这里，不进代码/日志/报告。未配置 → 审核/报告/Q&A/问答 返回 503，绝不以假数据兜底。
DATAPP_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DATAPP_LLM_API_KEY=
DATAPP_LLM_MODEL=qwen3.8-flash
# qwen3.8-flash 先推理再作答，Q&A 蒸馏 prompt 长，实测需 >120s；建议 300–420。
DATAPP_LLM_TIMEOUT=300

# 向量模型：走 DashScope 原生多模态端点（非 compatible-mode），key 复用上面的。
DATAPP_EMBEDDING_MODEL=tongyi-embedding-vision-flash
DATAPP_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com
DATAPP_EMBEDDING_DIMENSION=768
DATAPP_EMBEDDING_TIMEOUT=30

# ---------------- Q&A 知识 + RAG 问答 ----------------
DATAPP_QA_MAX_PAIRS=8
DATAPP_QA_BOOST=0.0
DATAPP_RAG_TOP_K=6
# 拒答阈值：最高余弦低于此值 → 无据拒答且**不调用模型**
DATAPP_RAG_MIN_SCORE=0.25
DATAPP_RAG_MAX_CONTEXT_CHARS=6000

# ---------------- 其它 ----------------
# /health 每次都 spawn OpenCLI 子进程，看板轮询下必须缓存
DATAPP_HEALTH_CACHE_TTL=30
